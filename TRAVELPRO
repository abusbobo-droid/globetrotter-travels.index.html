                <div class="flex justify-between items-center mb-6">
                    <h3 class="text-2xl font-bold">Book Your Trip</h3>
                    <button onclick="hideBookingModal()" class="text-gray-400 hover:text-gray-600 text-3xl leading-none">×</button>
                </div>
                
                <form id="booking-form" onsubmit="submitBooking(event)">
                    <div class="space-y-5">
                        <div>
                            <label class="block text-sm font-medium mb-1.5">Trip / Destination</label>
                            <select id="booking-trip" class="w-full border border-gray-300 rounded-2xl px-4 py-3 text-sm" required>
                                <option value="">Select a trip</option>
                                <option value="Santorini Escape">Santorini Escape – \$1,890</option>
                                <option value="Bali Wellness">Bali Wellness Retreat – \$1,250</option>
                                <option value="Marrakech Adventure">Marrakech Adventure – \$980</option>
                                <option value="Kyoto Culture">Kyoto Cultural Journey – \$2,450</option>
                            </select>
                        </div>
                        
                        <div class="grid grid-cols-2 gap-5">
                            <div>
                                <label class="block text-sm font-medium mb-1.5">Departure Date</label>
                                <input type="date" id="booking-date" value="2026-04-15" class="w-full border border-gray-300 rounded-2xl px-4 py-3 text-sm" required>
                            </div>
                            <div>
                                <label class="block text-sm font-medium mb-1.5">Travelers</label>
                                <select id="booking-travelers" class="w-full border border-gray-300 rounded-2xl px-4 py-3 text-sm" required>
                                    <option>1</option>
                                    <option selected>2</option>
                                    <option>3</option>
                                    <option>4</option>
                                </select>
                            </div>
                        </div>
                        
                        <div>
                            <label class="block text-sm font-medium mb-1.5">Full Name</label>
                            <input type="text" id="booking-name" class="w-full border border-gray-300 rounded-2xl px-4 py-3 text-sm" placeholder="John Doe" required>
                        </div>
                        
                        <div class="grid grid-cols-2 gap-5">
                            <div>
                                <label class="block text-sm font-medium mb-1.5">Email</label>
                                <input type="email" id="booking-email" class="w-full border border-gray-300 rounded-2xl px-4 py-3 text-sm" placeholder="you@email.com" required>
                            </div>
                            <div>
                                <label class="block text-sm font-medium mb-1.5">Phone</label>
                                <input type="tel" id="booking-phone" class="w-full border border-gray-300 rounded-2xl px-4 py-3 text-sm" placeholder="+1 (555) 123-4567">
                            </div>
                        </div>
                        
                        <div>
                            <label class="block text-sm font-medium mb-1.5">Special Requests</label>
                            <textarea id="booking-notes" rows="3" class="w-full border border-gray-300 rounded-3xl px-4 py-3 text-sm" placeholder="Dietary needs, room preferences, etc."></textarea>
                        </div>
                    </div>
                    
                    <div class="mt-8 flex gap-3">
                        <button type="button" onclick="hideBookingModal()" 
                                class="flex-1 py-3.5 border border-gray-300 rounded-2xl text-sm font-medium hover:bg-gray-50">
                            Cancel
                        </button>
                        <button type="submit" 
                                class="flex-1 py-3.5 bg-teal-700 hover:bg-teal-800 text-white font-semibold rounded-2xl text-sm">
                            Confirm Booking
                        </button>
                    </div>
                    
                    <p class="text-center text-xs text-gray-500 mt-4">No payment required today. We'll contact you within 24h.</p>
                </form>
            </div>
        </div>
    </div>

    <!-- Login Modal -->
    <div id="login-modal" class="hidden fixed inset-0 bg-black/60 flex items-center justify-center z-[100]">
        <div class="bg-white rounded-3xl w-full max-w-sm mx-4 p-8 modal">
            <div class="flex justify-between mb-6">
                <h3 class="text-2xl font-bold">Welcome back</h3>
                <button onclick="hideLoginModal()" class="text-3xl leading-none text-gray-400 hover:text-gray-600">×</button>
            </div>
            
            <form onsubmit="loginUser(event)">
                <div class="space-y-4">
                    <div>
                        <label class="block text-sm font-medium mb-1">Email</label>
                        <input type="email" class="w-full border border-gray-300 rounded-2xl px-4 py-3 text-sm" placeholder="you@email.com" value="demo@globetrotter.com" required>
                    </div>
                    <div>
                        <label class="block text-sm font-medium mb-1">Password</label>
                        <input type="password" class="w-full border border-gray-300 rounded-2xl px-4 py-3 text-sm" value="demo123" required>
                    </div>
                </div>
                
                <button type="submit" class="mt-6 w-full bg-teal-700 text-white py-3.5 rounded-2xl font-semibold text-sm hover:bg-teal-800">
                    Log in
                </button>
                
                <div class="text-center mt-4 text-sm">
                    <span class="text-gray-500">Don't have an account?</span> 
                    <a href="#" class="text-teal-700 font-medium">Sign up</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Toast Notification -->
    <div id="toast" class="hidden fixed bottom-6 left-1/2 -translate-x-1/2 bg-gray-900 text-white px-6 py-3 rounded-2xl text-sm flex items-center gap-x-3 shadow-xl">
        <span id="toast-message"></span>
    </div>

    <script>
        // Tailwind script
        function initTailwind() {
            // Already included via CDN
        }

        // Trip data
        const trips = [
            {
                id: 1,
                name: "Santorini Escape",
                destination: "Santorini",
                region: "europe",
                price: 1890,
                duration: "7 days",
                image: "https://picsum.photos/id/1016/600/400",
                rating: 4.9,
                reviews: 312,
                description: "Iconic blue domes, breathtaking sunsets, and luxury cliffside hotels."
            },
            {
                id: 2,
                name: "Bali Wellness Retreat",
                destination: "Bali",
                region: "asia",
                price: 1250,
                duration: "8 days",
                image: "https://picsum.photos/id/1005/600/400",
                rating: 4.8,
                reviews: 287,
                description: "Yoga, meditation, jungle villas, and cultural immersion."
            },
            {
                id: 3,
                name: "Marrakech Adventure",
                destination: "Marrakech",
                region: "africa",
                price: 980,
                duration: "6 days",
                image: "https://picsum.photos/id/1018/600/400",
                rating: 4.7,
                reviews: 195,
                description: "Explore the souks, ride camels in the desert, and stay in a riad."
            },
            {
                id: 4,
                name: "Kyoto Cultural Journey",
                destination: "Kyoto",
                region: "asia",
                price: 2450,
                duration: "9 days",
                image: "https://picsum.photos/id/1009/600/400",
                rating: 4.9,
                reviews: 164,
                description: "Temples, tea ceremonies, cherry blossoms, and traditional ryokans."
            },
            {
                id: 5,
                name: "Paris Romantic Getaway",
                destination: "Paris",
                region: "europe",
                price: 1650,
                duration: "5 days",
                image: "https://picsum.photos/id/1015/600/400",
                rating: 4.6,
                reviews: 423,
                description: "Eiffel Tower, Seine cruise, and charming boutique hotels."
            }
        ];

        // Render trip cards
        function renderTrips(filteredTrips = trips) {
            const container = document.getElementById('trips-grid');
            container.innerHTML = '';
            
            filteredTrips.forEach(trip => {
                const card = document.createElement('div');
                card.className = `trip-card bg-white border border-gray-200 rounded-3xl overflow-hidden`;
                card.innerHTML = `
                    <div class="relative">
                        <img src="${trip.image}" class="w-full h-48 object-cover" alt="${trip.name}">
                        <div class="absolute top-4 right-4 bg-white px-3 py-1 rounded-2xl text-xs font-semibold shadow">
                            
$$
{trip.price}
                        </div>
                    </div>
                    <div class="p-5">
                        <div class="flex justify-between items-start">
                            <div>
                                <div class="font-semibold text-lg">${trip.name}</div>
                                <div class="text-sm text-gray-500">${trip.destination} • ${trip.duration}</div>
                            </div>
                            <div class="text-right">
                                <div class="flex items-center gap-x-1 justify-end">
                                    <span class="text-amber-500"><i class="fa-solid fa-star"></i></span>
                                    <span class="font-semibold">${trip.rating}</span>
                                </div>
                                <div class="text-xs text-gray-500">${trip.reviews} reviews</div>
                            </div>
                        </div>
                        
                        <p class="text-sm text-gray-600 mt-3 line-clamp-2">${trip.description}</p>
                        
                        <div class="mt-4 flex gap-2">
                            <button onclick="bookTrip(${trip.id})" 
                                    class="flex-1 bg-teal-700 hover:bg-teal-800 text-white text-sm py-2.5 rounded-2xl font-semibold transition-colors">
                                Book Now
                            </button>
                            <button onclick="showTripDetails(${trip.id})" 
                                    class="flex-1 border border-gray-300 hover:bg-gray-50 text-sm py-2.5 rounded-2xl font-medium">
                                Details
                            </button>
                        </div>
                    </div>
                `;
                container.appendChild(card);
            });
        }

        // Filter trips by region
        function filterTrips(region) {
            const buttons = document.querySelectorAll('.filter-btn');
            buttons.forEach(btn => btn.classList.remove('active', 'bg-teal-100', 'text-teal-700'));
            
            const activeBtn = document.querySelector(`[data-filter="${region}"]`);
            if (activeBtn) {
                activeBtn.classList.add('active', 'bg-teal-100', 'text-teal-700');
            }
            
            let filtered = trips;
            if (region !== 'all') {
                filtered = trips.filter(t => t.region === region);
            }
            
            renderTrips(filtered);
        }

        // Filter by specific destination (from destination cards)
        function filterByDestination(destination) {
            const filtered = trips.filter(t => t.destination.toLowerCase() === destination.toLowerCase());
            document.getElementById('trips').scrollIntoView({ behavior: 'smooth' });
            
            setTimeout(() => {
                renderTrips(filtered);
            }, 300);
        }

        // Show all trips
        function showAllTrips() {
            renderTrips(trips);
            const buttons = document.querySelectorAll('.filter-btn');
            buttons.forEach(btn => btn.classList.remove('active', 'bg-teal-100', 'text-teal-700'));
            const allBtn = document.querySelector('[data-filter="all"]');
            if (allBtn) allBtn.classList.add('active', 'bg-teal-100', 'text-teal-700');
        }

        // Book a specific trip
        function bookTrip(tripId) {
            const trip = trips.find(t => t.id === tripId);
            if (!trip) return;
            
            const modal = document.getElementById('booking-modal');
            const tripSelect = document.getElementById('booking-trip');
            
            modal.classList.remove('hidden');
            modal.classList.add('flex');
            
            // Pre-select the trip
            setTimeout(() => {
                tripSelect.value = trip.name + " – $" + trip.price;
            }, 100);
        }

        // Show booking modal (generic)
        function showBookingModal() {
            const modal = document.getElementById('booking-modal');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }

        function hideBookingModal() {
            const modal = document.getElementById('booking-modal');
            modal.classList.remove('flex');
            modal.classList.add('hidden');
        }

        // Submit booking
        function submitBooking(e) {
            e.preventDefault();
            
            const form = document.getElementById('booking-form');
            const trip = document.getElementById('booking-trip').value;
            const date = document.getElementById('booking-date').value;
            const travelers = document.getElementById('booking-travelers').value;
            const name = document.getElementById('booking-name').value;
            
            // Simulate successful booking
            hideBookingModal();
            
            setTimeout(() => {
                showToast(`Thank you, ${name.split(' ')[0]}! Your booking for ${trip} on ${date} has been received. We'll contact you shortly.`);
                form.reset();
            }, 300);
        }

        // Login modal
        function showLoginModal() {
            document.getElementById('login-modal').classList.remove('hidden');
            document.getElementById('login-modal').classList.add('flex');
        }
        
        function hideLoginModal() {
            const modal = document.getElementById('login-modal');
            modal.classList.remove('flex');
            modal.classList.add('hidden');
        }
        
        function loginUser(e) {
            e.preventDefault();
            hideLoginModal();
            showToast('Welcome back! You are now logged in.');
        }

        // Toast notification
        function showToast(message) {
            const toast = document.getElementById('toast');
            const msgEl = document.getElementById('toast-message');
            
            msgEl.textContent = message;
            toast.classList.remove('hidden');
            toast.classList.add('flex');
            
            setTimeout(() => {
                toast.classList.remove('flex');
                toast.classList.add('hidden');
            }, 4500);
        }

        // Search trips
        function searchTrips() {
            const dest = document.getElementById('search-destination').value.toLowerCase().trim();
            const date = document.getElementById('search-date').value;
            const travelers = document.getElementById('search-travelers').value;
            
            let filtered = trips;
            
            if (dest) {
                filtered = filtered.filter(t => 
                    t.destination.toLowerCase().includes(dest) || 
                    t.name.toLowerCase().includes(dest)
                );
            }
            
            document.getElementById('trips').scrollIntoView({ behavior: 'smooth' });
            
            setTimeout(() => {
                renderTrips(filtered);
                if (filtered.length === 0) {
                    showToast('No trips found matching your search. Try different keywords.');
                }
            }, 300);
        }

        // Show trip details
        function showTripDetails(tripId) {
            const trip = trips.find(t => t.id === tripId);
            if (!trip) return;
            
            const modalHTML = `
                <div class="fixed inset-0 bg-black/60 flex items-center justify-center z-[100]" onclick="this.remove()">
                    <div class="bg-white rounded-3xl max-w-md w-full mx-4 p-0 modal" onclick="event.stopImmediatePropagation()">
                        <img src="${trip.image}" class="w-full h-56 object-cover rounded-t-3xl" alt="${trip.name}">
                        <div class="p-6">
                            <div class="flex justify-between items-start">
                                <div>
                                    <div class="font-bold text-2xl">${trip.name}</div>
                                    <div class="text-teal-700">${trip.destination} • ${trip.duration}</div>
                                </div>
                                <div class="text-right">
                                    <div class="font-bold text-2xl">
$$
{trip.price}</div>
                                    <div class="text-xs text-gray-500">per person</div>
                                </div>
                            </div>
                            
                            <div class="flex items-center gap-x-2 mt-4">
                                <div class="flex text-amber-500">
                                    ${Array(5).fill('<i class="fa-solid fa-star"></i>').join('')}
                                </div>
                                <span class="font-semibold">${trip.rating}</span>
                                <span class="text-sm text-gray-500">(${trip.reviews} reviews)</span>
                            </div>
                            
                            <p class="mt-4 text-gray-600">${trip.description}</p>
                            
                            <div class="mt-6 grid grid-cols-2 gap-3">
                                <button onclick="bookTrip(${trip.id}); this.closest('.fixed').remove();" 
                                        class="bg-teal-700 hover:bg-teal-800 text-white py-3 rounded-2xl font-semibold text-sm">
                                    Book This Trip
                                </button>
                                <button onclick="this.closest('.fixed').remove()" 
                                        class="border border-gray-300 py-3 rounded-2xl font-medium text-sm hover:bg-gray-50">
                                    Close
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            `;
            
            document.body.insertAdjacentHTML('beforeend', modalHTML);
        }

        // Mobile menu
        function toggleMobileMenu() {
            const nav = document.querySelector('nav');
            const menu = document.createElement('div');
            menu.className = 'md:hidden bg-white border-t px-6 py-6';
            menu.innerHTML = `
                <div class="flex flex-col gap-y-4 text-sm font-medium">
                    <a href="#destinations" class="py-1">Destinations</a>
                    <a href="#trips" class="py-1">Trips</a>
                    <a href="#about" class="py-1">About Us</a>
                    <a href="#blog" class="py-1">Stories</a>
                    <a href="#contact" class="py-1">Contact</a>
                    <div class="pt-4 border-t">
                        <button onclick="showBookingModal(); this.closest('.md\\:hidden').remove()" class="w-full bg-teal-700 text-white py-3 rounded-2xl text-sm font-semibold">
                            Book Now
                        </button>
                    </div>
                </div>
            `;
            
            // Remove existing mobile menu if any
            const existing = document.querySelector('.md\\:hidden.bg-white.border-t');
            if (existing) existing.remove();
            
            nav.parentNode.insertBefore(menu, nav.nextSibling);
            
            // Close on link click
            menu.querySelectorAll('a').forEach(link => {
                link.onclick = () => menu.remove();
            });
        }

        // Initialize everything
        function init() {
            initTailwind();
            renderTrips(trips);
            
            // Make filter buttons work properly
            const filterButtons = document.querySelectorAll('.filter-btn');
            filterButtons.forEach(btn => {
                btn.addEventListener('click', () => {
                    const filter = btn.getAttribute('data-filter');
                    filterTrips(filter);
                });
            });
            
            // Set initial active filter
            const allBtn = document.querySelector('[data-filter="all"]');
            if (allBtn) {
                allBtn.classList.add('active', 'bg-teal-100', 'text-teal-700');
            }
            
            // Allow Enter key in search
            const searchInput = document.getElementById('search-destination');
            if (searchInput) {
                searchInput.addEventListener('keypress', function(e) {
                    if (e.key === 'Enter') {
                        searchTrips();
                    }
                });
            }
            
            // Demo toast on first load (optional)
            // setTimeout(() => { showToast('Welcome! Try searching or booking a trip.'); }, 3000);
            
            console.log('%c[GlobeTrotter] Travel agency website initialized successfully', 'color:#0f766e');
        }
        
        // Start the site
        window.onload = init;
    </script>
</body>
</html>

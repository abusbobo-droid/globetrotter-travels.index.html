    <!-- Blog / Stories Section -->
    <section id="blog" class="max-w-screen-xl mx-auto px-6 py-16">
        <div class="flex items-end justify-between mb-8">
            <div>
                <span class="uppercase text-teal-700 text-xs tracking-[2px] font-semibold">Travel stories</span>
                <h2 class="section-header tracking-tight">From our travelers</h2>
            </div>
            <a href="#" class="hidden md:flex items-center gap-x-2 text-sm font-medium text-teal-700">View all stories</a>
        </div>
        
        <div class="grid md:grid-cols-3 gap-6">
            <div class="bg-white rounded-3xl overflow-hidden border">
                <img src="https://picsum.photos/id/1015/400/220" class="w-full h-48 object-cover" alt="">
                <div class="p-6">
